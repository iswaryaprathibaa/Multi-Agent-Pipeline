# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- ChromaDB ---
CHROMA_PERSIST_DIR=chroma_db
CHROMA_COLLECTION=research_kb

# --- Pipeline ---
MAX_REVISIONS=2

# --- LangSmith (tracing) ---
LANGSMITH_API_KEY=lsv2-your-langsmith-key-here
LANGSMITH_PROJECT=multi-agent-research-pipeline
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- FastAPI backend (server/) ---
# Comma-separated list of origins allowed to call the API (your Vercel domain
# in production). Leave as * for local development only.
ALLOWED_ORIGINS=*
# Optional: if set, /run and /kb/* require this key (header X-API-Key for
# POST routes, ?api_key= query param for the GET /run SSE endpoint).
SERVER_API_KEY=
